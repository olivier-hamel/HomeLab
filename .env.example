# Compose interpolation only; this file is not injected into either app.
# Copy to .env at the repository root. Never put credentials here.
COMPOSE_PROJECT_NAME=homelab

# Local access by default. For LAN access, set this to your server's LAN IP.
# Use 0.0.0.0 only if you intend to listen on all IPv4 interfaces.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
