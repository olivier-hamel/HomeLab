# Compose interpolation only; this file is not injected into either app.
# Copy to .env at the repository root. Never put credentials here.
COMPOSE_PROJECT_NAME=homelab

# Local access by default. For LAN access, set this to your server's LAN IP.
# Use 0.0.0.0 only if you intend to listen on all IPv4 interfaces.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

# Private HTTPS. Caddy uses internal listeners 8443 (LAN) and 8444 (Tailscale).
FRONTEND_HTTPS_PORT=3443
HTTPS_LAN_HOST=localhost
HTTPS_TAILSCALE_HOST=localhost

# Optional second private interface. Defaults use distinct loopback ports.
TAILSCALE_BIND_ADDRESS=127.0.0.1
TAILSCALE_PORT=3002
TAILSCALE_HTTPS_PORT=3444

# Memo source checkout beside this repository.
MEMO_SOURCE_DIR=../memo
