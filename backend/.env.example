# Backend runtime configuration, loaded by Compose from backend/.env.
# Add missing settings to your existing backend/.env; preserve existing values.
# This file and its values must never be copied into Docker images or build args.
# Compose fixes NODE_ENV, HOSTNAME, PORT and NEXT_TELEMETRY_DISABLED separately.
# If a value contains $, use single quotes to avoid interpolation.

# TV & Movies is disabled until you secure LAN/tailnet access and opt in.
MEDIA_TRUSTED_NETWORK=false
# Exact browser origins, comma-separated, no trailing slash. Use YOUR VM name/IP.
MEDIA_ALLOWED_ORIGINS=http://localhost:3000
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MEDIA_SESSION_SECRET=

# Reachable FROM THE BACKEND CONTAINER, across Tailscale between the two VMs.
PROWLARR_BASE_URL=
PROWLARR_API_KEY=
TORRSERVER_BASE_URL=
# Set both only when TorrServer HTTP Basic authentication is enabled.
TORRSERVER_USERNAME=
TORRSERVER_PASSWORD=
# TMDB API Read Access Token (Bearer). Optional; source search is independent.
TMDB_READ_ACCESS_TOKEN=

# Optional online subtitles from SubDL. Obtain a key from https://subdl.com/panel.
# Kept server-side; torrent and local subtitles work without this key.
SUBDL_API_KEY=

# Milliseconds. Search timeout applies per indexer (up to four concurrently).
MEDIA_METADATA_TIMEOUT_MS=10000
MEDIA_SEARCH_TIMEOUT_MS=20000
# Long video bodies have no total duration limit. These bound headers / idle reads.
MEDIA_STREAM_HEADER_TIMEOUT_MS=90000
MEDIA_STREAM_IDLE_TIMEOUT_MS=45000
