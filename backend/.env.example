# Backend runtime configuration, loaded by Compose from backend/.env.
# Add missing settings to your existing backend/.env; preserve existing values.
# This file and its values must never be copied into Docker images or build args.
# Compose fixes NODE_ENV, HOSTNAME, PORT and NEXT_TELEMETRY_DISABLED separately.
# If a value contains $, use single quotes to avoid interpolation.

# TV & Movies is disabled until you secure LAN/tailnet access and opt in.
MEDIA_TRUSTED_NETWORK=false
# Exact browser origins, comma-separated, no trailing slash. Use YOUR VM name/IP.
MEDIA_ALLOWED_ORIGINS=https://localhost:3443
# Mémo is the shared account/session authority. Compose sets http://memo:8000.
# For local development, run Mémo with FLASHCARD_WEB_AUTH=1.
MEMO_AUTH_URL=http://127.0.0.1:8000
# Tapo C200 / Veille. Credentials can also be set privately in the Caméra app.
# Use the separate Camera Account created in Tapo, not the TP-Link cloud login.
TAPO_HOST=192.168.0.188
TAPO_MASK=255.255.255.0
TAPO_GATEWAY=192.168.0.1
TAPO_DNS=192.168.0.202
TAPO_NAME=
TAPO_USERNAME=
TAPO_PASSWORD=
# Local default: ../.local-data/camera; Docker: persistent /data/camera volume.
CAMERA_STORAGE_PATH=
# Personal read-only Moodle MCP connector, reached through the supervised SSH forward.
# Leave URL/users empty to disable access. Only explicitly allowed HomeLab usernames
# can use the one Moodle account; this does not authenticate each user to Moodle.
MOODLE_MCP_URL=
MOODLE_ALLOWED_USERS=
# Bibliothèque: le serveur vérifie Moodle toutes les 30 minutes, même sans navigateur.
LIBRARY_MOODLE_SEMESTER=A26
# Tempo : session actuelle détectée à Toronto; vide = automatique (H/E/A).
# Synchronisation déterministe des événements et remises toutes les 30 minutes.
CALENDAR_MOODLE_SEMESTER=
# Optionnel en local; Docker inclut LibreOffice pour les aperçus PowerPoint.
LIBRARY_SOFFICE_PATH=
# Optionnel en local. Docker utilise son volume persistant /data/library.
LIBRARY_STORAGE_PATH=
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MEDIA_SESSION_SECRET=

# Reachable FROM THE BACKEND CONTAINER, across Tailscale between the two VMs.
PROWLARR_BASE_URL=
PROWLARR_API_KEY=
TORRSERVER_BASE_URL=
# Set both only when TorrServer HTTP Basic authentication is enabled.
TORRSERVER_USERNAME=
TORRSERVER_PASSWORD=

# Téléchargements conservés jusqu’à suppression. Docker : volume /data/media-downloads.
# En local, valeur vide : backend/.local-data/media-downloads.
MEDIA_DOWNLOAD_STORAGE_PATH=
# Nombre maximal de téléchargements simultanés sur le serveur (1 à 10).
MEDIA_DOWNLOAD_CONCURRENCY=3
# Espace libre minimal conservé avant de démarrer un téléchargement (MiB).
MEDIA_DOWNLOAD_RESERVE_MIB=512
# Les pauses torrent tolèrent 3 minutes sans données, indépendamment de la lecture.
MEDIA_DOWNLOAD_IDLE_TIMEOUT_MS=180000
# Reprises automatiques après une coupure réseau, puis bouton Reprendre.
MEDIA_DOWNLOAD_RETRIES=3
MEDIA_DOWNLOAD_RETRY_DELAY_MS=10000
# TMDB API Read Access Token (Bearer). Optional; source search is independent.
TMDB_READ_ACCESS_TOKEN=
# Optional IMDb ratings in movie info panels. Obtain a key from https://www.omdbapi.com/apikey.aspx.
OMDB_API_KEY=

# Optional online subtitles from SubDL. Obtain a key from https://subdl.com/panel.
# Kept server-side; torrent and local subtitles work without this key.
SUBDL_API_KEY=

# Server-only OpenAI configuration for all Tempo event creation and PDF/PowerPoint scans.
# Add your real key to backend/.env; the root .env is only for Compose settings.
# Text event creation uses gpt-6-luna; PDF/PowerPoint scans use gpt-6.1-sol.
# Both models are fixed in server code.
# Sends submitted descriptions/documents, current/selected dates, timezone and event types.
# Without a key (or during API failures), manual event creation remains available.
OPENAI_API_KEY=

# Server-only Gemini configuration for TV & Movies.
# Optional catalogue spelling fallback, source recommendations and cinema headlines using Gemini 3.5 Flash-Lite.
# Personalized title recommendations use the same Gemini model as the other media AI features.
# Server-side only. Get a key from https://aistudio.google.com/apikey.
# Sends catalogue metadata and up to 25 recent watch-history entries to Gemini; no torrent links or file contents.
# Without a key (or during API failures), TMDB search and basic recommendations remain available.
GEMINI_API_KEY=
# Leave blank to keep HomeLab’s default Gemini model.
GEMINI_MODEL=

MEDIA_AI_TIMEOUT_MS=20000
# Discovery may need more time to produce a complete batch; other AI features keep their timeout above.
MEDIA_DISCOVERY_AI_TIMEOUT_MS=30000

# Milliseconds. Search timeout applies per indexer (up to four concurrently).
MEDIA_METADATA_TIMEOUT_MS=10000
MEDIA_SEARCH_TIMEOUT_MS=20000
# Long video bodies have no total duration limit. These bound headers / idle reads.
MEDIA_STREAM_HEADER_TIMEOUT_MS=90000
MEDIA_STREAM_IDLE_TIMEOUT_MS=45000

# FFmpeg and ffprobe are included in the backend Docker image.
# Local development: install FFmpeg and put both binaries on PATH, or set paths.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_PROBE_TIMEOUT_MS=90000
# Shared remux/transcode process limit. Direct streams do not use these slots.
MEDIA_MAX_CONVERSIONS=2

# Shared MongoDB storage: Calendar events, Continue Watching and watch history.
# Calendar requires this connection. Collections and indexes are created automatically.
# The URI may contain
# <db_username> and <db_password>; values below are URL-encoded before insertion.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
MONGODB_DATABASE=homelab
# Keep this household namespace to preserve existing cinema progress/history.
# The active profile is a verified Mémo username, independently of who logged in.
MEDIA_USER_ID=home
# Legacy fallback for direct storage callers; the authenticated media API uses
# the connected username by default and accepts other existing account profiles.
MEDIA_PROFILE_ID=default
