[Unit]
Description=Personal ChatGPT Plus browser bridge
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=chatgpt-bridge
Group=chatgpt-bridge
WorkingDirectory=/opt/chatgpt-bridge/app
EnvironmentFile=/etc/chatgpt-bridge/bridge.env
Environment=PATH=/opt/chatgpt-bridge/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/chatgpt-bridge/node/bin/node /opt/chatgpt-bridge/app/dist/main.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=mixed
UMask=0077
StateDirectory=chatgpt-bridge
StateDirectoryMode=0700
CacheDirectory=chatgpt-bridge
CacheDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CPUAccounting=true
MemoryAccounting=true
CPUQuota=100%
MemoryHigh=1536M
OOMPolicy=kill
TasksMax=512
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
