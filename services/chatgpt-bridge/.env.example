# API locale par défaut. Pour une app sur le même LAN, voir API.md.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3211
# Obligatoire si BRIDGE_HOST écoute sur le LAN ; utiliser le vrai sous-réseau local.
# BRIDGE_HOST=0.0.0.0
# BRIDGE_LAN_CIDRS=192.168.1.0/24
# BRIDGE_ALLOWED_HOSTS=192.168.1.50
# Noms d'hôte supplémentaires autorisés, sans schéma ni port ; aucun joker.
# BRIDGE_ALLOWED_HOSTS=chatgpt-bridge.home.arpa
# Origines exactes des apps Web, séparées par des virgules ; vide pour une app native/backend.
# BRIDGE_ALLOWED_ORIGINS=http://192.168.1.20:3000
# Moteur, VNC et noVNC restent toujours sur 127.0.0.1.
BRIDGE_ENGINE_PORT=3210
BRIDGE_VNC_PORT=5901
BRIDGE_MAINTENANCE_PORT=6081
BRIDGE_TIMEOUT_MS=300000
BRIDGE_MAINTENANCE_TTL_MS=900000
# Chemin absolu facultatif ; par défaut .local-data dans ce projet.
# BRIDGE_DATA_DIR=/chemin/prive/chatgpt-bridge
# Cache Chromium indépendant du code pour une installation serveur.
# BRIDGE_BROWSERS_DIR=/var/cache/chatgpt-bridge/browsers
# Binaire Chromium de Playwright installé par npm run setup, sans profil personnel.
# Les secrets sont générés dans le répertoire privé ; aucun jeton OpenAI à fournir.
