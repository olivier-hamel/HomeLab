{
	admin off
	auto_https off
	persist_config off
	grace_period 10s
}

:8080 {
	root * /srv
	encode zstd gzip
	log

	# route preserves this order even when matchers have different specificity.
	route {
		header X-Content-Type-Options nosniff

		handle /healthz {
			header Cache-Control no-store
			respond "ok" 200
		}

		@api path /api /api/*
		handle @api {
			# handle preserves /api; handle_path would strip it.
			reverse_proxy backend:3001
		}

		# All Vite assets (including extensionless paths) must really exist.
		@assets path /assets /assets/*
		handle @assets {
			file_server
		}

		# Reserve paths containing a dotted component for files, never SPA HTML.
		@files path_regexp files /[^/]*\.[^/]*(/|$)
		handle @files {
			file_server
		}

		handle {
			header Cache-Control no-cache
			try_files {path} /index.html
			file_server
		}
	}
}
